{
	"schemaVersion": 1,
	"id": "quantdrop",
	"version": "${version}",
	"name": "QuantDrop",
	"description": "Client-side Fabric mod for quickly dropping items from open containers.",
	"authors": [
		"DJDevs"
	],
	"contact": {
		"sources": "https://github.com/djnejk/QuantDrop"
	},
	"license": "MIT",
	"icon": "assets/quantdrop/icon.png",
	"environment": "client",
	"entrypoints": {
		"main": [
			"com.djdevs.quantdrop.QuantDropMod"
		],
		"client": [
			"com.djdevs.quantdrop.client.QuantDropClient"
		]
	},
	"mixins": [
		"quantdrop.client.mixins.json"
	],
	"depends": {
		"fabricloader": ">=0.19.2",
		"minecraft": "~26.1.2",
		"java": ">=25",
		"fabric-api": "*"
	}
}
